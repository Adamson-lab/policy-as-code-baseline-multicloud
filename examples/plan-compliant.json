{
  "resource_changes": [
    {
      "address": "aws_s3_bucket_public_access_block.compliant",
      "type": "aws_s3_bucket_public_access_block",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        }
      }
    },
    {
      "address": "azurerm_storage_account.compliant",
      "type": "azurerm_storage_account",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "allow_nested_items_to_be_public": false,
          "enable_https_traffic_only": true,
          "shared_access_key_enabled": false
        }
      }
    },
    {
      "address": "google_storage_bucket.compliant",
      "type": "google_storage_bucket",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "public_access_prevention": "enforced",
          "encryption": [
            {
              "default_kms_key_name": "x"
            }
          ],
          "location": "US"
        }
      }
    },
    {
      "address": "aws_ebs_volume.compliant",
      "type": "aws_ebs_volume",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "encrypted": true
        }
      }
    },
    {
      "address": "aws_db_instance.compliant",
      "type": "aws_db_instance",
