{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PAC006DenyAccessKeyCreation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/pac-platform-admin"
          ]
        }
      }
    }
  ]
}
